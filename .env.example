ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5
KAFKA_BOOTSTRAP_SERVERS=localhost:19092
PATIENT_EVENTS_TOPIC=patient_events
PROVIDER_LANDING_PATH=./data/landing/providers
PIPELINE_STATE_PATH=./data/state/pipeline_state.json
GOLD_DUCKDB_PATH=./data/seed/gold.duckdb
AUDIT_LOG_PATH=./data/state/audit_log.jsonl

# Optional. Langfuse tracing for agent/llm.py's Claude.run_tool_loop is a true
# no-op (no import, no network calls) unless BOTH keys below are set.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# Optional. Live Databricks workspace (agent/databricks_client.py). Unset, the
# agent uses its local stand-ins: DuckDB for DA-mode queries, the JSON state
# file for DE-mode health checks. DATABRICKS_TOKEN is read via GCP Secret
# Manager when GCP_PROJECT_ID is set, so it never needs to live in this file.
DATABRICKS_HOST=
DATABRICKS_TOKEN=
# SQL warehouse ID for DA-mode queries against healthcare_agentic_de.gold.
DATABRICKS_WAREHOUSE_ID=
# JSON map of bundle pipeline name -> pipeline ID for DE-mode tools, e.g.
# {"streaming_patient_pipeline": "<id>", "reference_data_pipeline": "<id>"}
# (IDs from `databricks bundle summary` after `databricks bundle deploy`).
DATABRICKS_PIPELINE_IDS=
